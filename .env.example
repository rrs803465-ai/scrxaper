# Render: use /var/data (the persistent disk). Railway: use /data (a Volume).
PORT=3000
NODE_ENV=production
DB_PATH=/var/data/scrxaper.db
UPLOAD_DIR=/var/data/uploads
# Number of proxies in front of the app. 1 on Render and Railway; 0 when running locally.
TRUST_PROXY_HOPS=1
OWNER_USERNAME=choose_a_username
OWNER_PASSWORD=at-least-12-characters-long
AI_KEY_SECRET=generate-at-least-32-random-characters
CURRENCY_NAME=Sparks
# Web Push (calls and messages when the app is closed). VAPID keys are generated and stored in the database on first start.
VAPID_SUBJECT=mailto:you@example.com
# WebRTC: STUN works for most networks. Add a TURN server so calls connect behind strict NATs.
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Public link to the Android APK (a GitHub Release asset). Powers the Android app button on the landing page and in Studio.
# APK_URL=https://github.com/OWNER/REPO/releases/download/android-latest/scrxaper.apk

# Public link to the Windows installer (a GitHub Release asset from .github/workflows/windows.yml). Powers the Windows app button.
# EXE_URL=https://github.com/OWNER/REPO/releases/download/windows-latest/Scrxaper-Setup.exe

# Continue with Google (through Supabase). Create a Supabase project, enable Authentication, Providers, Google, and add your site
# address (for example https://chat.example.com/app) under Authentication, URL Configuration, Redirect URLs.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key

# First-run setup wizard: with no owner yet, the app asks for a setup code. It is printed in the server log, or choose your own here.
# SETUP_CODE=choose-a-long-random-code

# Optional: override the music search sources (defaults are the public iTunes and Audius APIs).
# MUSIC_ITUNES_URL=https://itunes.apple.com
# MUSIC_AUDIUS_URL=https://api.audius.co
