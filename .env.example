# Render: use /var/data (the persistent disk). Railway: use /data (a Volume).
PORT=3000
NODE_ENV=production
DB_PATH=/data/scrxaper.db
UPLOAD_DIR=/data/uploads
# Number of proxies in front of the app. 1 on Render and Railway; 0 when running locally.
TRUST_PROXY_HOPS=1
OWNER_USERNAME=choose_a_username
OWNER_PASSWORD=at-least-12-characters-long
AI_KEY_SECRET=generate-at-least-32-random-characters
CURRENCY_NAME=Sparks
# Web Push (calls and messages when the app is closed). VAPID keys are generated and stored in the database on first start.
VAPID_SUBJECT=mailto:you@example.com
# WebRTC: STUN works for most networks. Add a TURN server so calls connect behind strict NATs.
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Public link to the Android APK (a GitHub Release asset). Powers the Android app button on the landing page and in Studio.
# APK_URL=https://github.com/rrs803465-ai/scrxaper/releases/download/android-latest/scrxaper.apk
